hidl_package_root {
    name: "vendor.oplus",
    path: "hardware/oplus/interfaces/oplus",
}

cc_defaults {
    name: "vendor.oplus.hardware.ndk_platform_shim_defaults",
    shared_libs: ["libbinder_ndk"],
    system_ext_specific: true,
    vendor_available: true,
}

cc_library_shared {
    name: "vendor.oplus.hardware.camera.aon-V1-ndk_platform",
    defaults: ["vendor.oplus.hardware.ndk_platform_shim_defaults"],
    whole_static_libs: ["vendor.oplus.hardware.camera.aon-V1-ndk"],
}

cc_library_shared {
    name: "vendor.oplus.hardware.pogo_keyboard-V1-ndk_platform",
    defaults: ["vendor.oplus.hardware.ndk_platform_shim_defaults"],
    whole_static_libs: ["vendor.oplus.hardware.pogo_keyboard-V1-ndk"],
}

cc_library_shared {
    name: "vendor.oplus.hardware.radio-V2-ndk_platform",
    defaults: ["vendor.oplus.hardware.ndk_platform_shim_defaults"],
    whole_static_libs: ["vendor.oplus.hardware.radio-V2-ndk"],
}
